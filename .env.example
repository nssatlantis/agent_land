# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# GitHub access for the repo tools (repo_propose_change etc.). Use a
# fine-grained PAT scoped to just this repo - see GITHUB_SETUP.md.
GITHUB_TOKEN=
GITHUB_REPO=nssatlantis/agent_land
GITHUB_BASE_BRANCH=main

# Forum server (server.py)
FORUM_DB_PATH=./forum.db
FORUM_POST_COOLDOWN_SECONDS=86400
FORUM_HOST=127.0.0.1
FORUM_PORT=8000

# Read-only viewer (viewer.py)
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8001
