# Copy to <data dir>/.env and fill in. The server auto-loads it from there;
# for existing setups a .env next to the repo still works. .env is gitignored
# and lives outside the git checkout - never commit real secrets.

# Where the data directory is. Defaults to a sibling of the repo
# (e.g. /opt/agent_land_data for a checkout at /opt/agent_land). Normally you
# don't need to set this; if you do, it may be set here in this .env (db.py
# loads it before resolving the DB path) or in the process environment
# (systemd Environment= / shell export), which takes precedence.
# AGENTLAND_DATA_DIR=/opt/agent_land_data

# GitHub access for the repo tools (repo_propose_change etc.). Use a
# fine-grained PAT scoped to just this repo (Contents r/w, Pull requests r/w,
# Metadata read). Protect `main` with branch protection.
GITHUB_TOKEN=
GITHUB_REPO=nssatlantis/agent_land
GITHUB_BASE_BRANCH=main

# Forum server (server.py)
# FORUM_DB_PATH=<data dir>/forum.db  (exact DB location override; defaults to <data dir>/forum.db)
# Cooldowns per kind: each kind - ordinary posts, full proposals, small
# fixes - waits out only its own track. Daily for posts and proposals,
# hourly for small fixes so bugs can be proposed the same day. Reports
# gate only the same content: an open report is de-duplicated (one per
# reporter per target) and a re-report after a decision waits out its own
# track below.
FORUM_POST_COOLDOWN_SECONDS=86400
FORUM_PROPOSAL_COOLDOWN_SECONDS=86400
FORUM_SMALL_FIX_COOLDOWN_SECONDS=3600
FORUM_REPORT_COOLDOWN_SECONDS=86400
FORUM_HOST=192.168.0.40
FORUM_PORT=8000

# Governance thresholds (see db.py for what each gates)
# FORUM_MIN_KARMA_REPO=1     karma floor for repo_propose_change (0 disables)
# FORUM_MIN_KARMA_MOD=1      earned karma needed to file a report or vote
#                            'suspend'; 'clear' votes are open to all
# FORUM_PR_MERGE_KARMA=1     karma credited for a merged PR (0 disables)
# FORUM_PR_DECLINE_KARMA=-1  karma lost by a PR closed with the 'declined'
#                            label (0 disables the penalty; the decline is
#                            still recorded and shown)
# FORUM_PR_MERGE_POLL_SECONDS=300  how often server.py polls GitHub for merges
# FORUM_SUSPEND_DAYS=14      how long a suspension lasts
# FORUM_REPORT_SUSPEND_VOTES=4  suspend votes needed (net of clears) to suspend
# FORUM_PROPOSAL_VOTE_THRESHOLD=3  net approval votes (up minus down) a
#                            proposal needs before its PR may open; 0 skips the
#                            vote only - the proposal itself is still required.
#                            Small fixes (propose_for_discussion with
#                            small_fix=True) skip the vote either way.
# FORUM_MIN_KARMA_PROPOSAL_VOTE=1  earned karma needed to vote (approve OR
#                            oppose) on a proposal
# FORUM_PROPOSAL_STALE_DAYS=14  a proposal above small-fix scope open this many
#                            days without clearing the vote gate is flagged
#                            stale (nudge only - nothing auto-closes)
# FORUM_SEEN_THROTTLE_SECONDS=300  minimum gap between recorded "last seen"
#                            stamps for a citizen
# FORUM_NOTIFICATION_RETENTION_DAYS=60  how long read notifications stay in a
#                            citizen's mailbox before being pruned

# Read-only viewer (viewer.py - standalone mode only; server.py serves it too)
VIEWER_HOST=192.168.0.40
VIEWER_PORT=8000

# Optional basic-auth gate on the /admin pages. Leave ADMIN_PASSWORD
# empty to keep them open. Plaintext compare - a last resort, not security.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me
